{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": [
		"packages/**",
		"apps/**",
		".template/**",
		".changeset/**",
		"**/*.grit",
		"**/dist/**",
		"**/build/**",
		"**/.turbo/**",
		"**/.next/**",
		"**/coverage/**",
		"**/node_modules/**",
		"**/public/**",
	],
	"useTabs": true,
	"tabWidth": 2,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"semi": true,
	"singleAttributePerLine": true,
}
