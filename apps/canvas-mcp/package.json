		"shiki": "^4.5.0"
	},
	"devDependencies": {
		"@instructure.ai/shared-configs": "workspace:^",
		"@pantoken/plugin-props-minify": "0.1.4",
		"postcss": "8.5.30"
	},
	"engines": {
		"node": ">=24.15.0"
