{
	"name": "<<packagename>>",
	"version": "0.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/instructure/instructure.ai",
		"directory": "packages/<<cliname>>"
	},
	"bin": {
		"<<cliname>>": "./src/index.mjs"
	},
	"files": [
		"src"
	],
	"type": "module",
	"main": "./src/index.mjs",
	"types": "./src/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./src/index.d.mts",
				"default": "./src/index.mjs"
			},
			"require": {
				"types": "./src/index.d.cts",
				"default": "./src/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "vp pack && pnpm pack --pack-destination ./src",
		"typecheck": "tsc --noEmit",
		"lint": "vp lint",
		"test": "vp test run",
		"<<cliname>>": "node ./src/index.mjs",
		"check": "vp check",
		"release": "vpx ../../scripts/release.mts"
	},
	"devDependencies": {
		"@instructure.ai/shared-configs": "workspace:^",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=26.12.1"
	}
}
