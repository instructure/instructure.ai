{
	"compilerOptions": {
		"paths": {
			"<<packagename>>": ["./node/index.mts"]
		},
		"target": "ES2024",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"outDir": "src",
		"rootDir": "node",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"extends": "../../tsconfig.json",
	"include": ["node"]
}
